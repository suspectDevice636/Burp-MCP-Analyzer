# Burp MCP Analyzer configuration

# --- Server -----------------------------------------------------------
# Loopback by default. If you bind elsewhere, API_TOKEN is mandatory.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
API_TOKEN=
LOG_LEVEL=INFO
# Service events (model errors, pauses, Burp failures) are also written to a rotating file.
# Empty = <DATA_DIR>/analyzer.log, "off" = disable.
LOG_FILE=

# --- Scope ------------------------------------------------------------
# Scope now belongs to each engagement (set it in the review page). This value is only used
# once, as the scope of the engagement created when earlier single-database data is imported.
SCOPE_HOSTS=

# --- Burp MCP extension -----------------------------------------------
# Streamable HTTP lives at /mcp; the legacy SSE endpoint is the root path.
BURP_MCP_URL=http://127.0.0.1:9876/mcp
BURP_MCP_TRANSPORT=http
# If you reach Burp through a port forward and get 403s, the extension may only
# accept a loopback Host header. Then set e.g. 127.0.0.1:9876
BURP_HOST_HEADER=
BURP_TIMEOUT=60
HISTORY_PAGE_SIZE=50

# --- Ollama -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
# Max tokens the model may generate per triage call (0 = no cap). Stops a runaway reply timing out.
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# --- Analysis ---------------------------------------------------------
LLM_ENABLED=true
LLM_SKIP_JS=true
MAX_BODY_CHARS=4000
# Highest severity the model may assign, and only when it reports high confidence
# (otherwise it is capped at low). You set the final severity when you confirm.
LLM_SEVERITY_CAP=medium
# Near-duplicate endpoints (e.g. /api/products/1 and /api/products/2) are model-reviewed at
# most this many times. 0 = review every one. Deterministic checks always run on everything.
LLM_MAX_PER_ENDPOINT=3
# Paths (substring match) never sent to the model.
LLM_SKIP_PATHS=/socket.io/,/health,/ping,/favicon,/manifest.json

# --- Storage ----------------------------------------------------------
# SQLite must live on local disk. BACKUP_DIR (e.g. the NAS mount) is copy-only.
DATA_DIR=./data
BACKUP_DIR=
